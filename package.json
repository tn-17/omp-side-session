{
	"name": "omp-side-session",
	"version": "0.1.0",
	"description": "Open persisted OMP side conversations in paired Herdr panes with durable handoffs.",
	"license": "MIT",
	"author": "Thien Nguyen",
	"type": "module",
	"exports": "./index.ts",
	"types": "./index.ts",
	"keywords": [
		"omp-plugin",
		"omp-extension",
		"side-session",
		"herdr"
	],
	"homepage": "https://github.com/tn-17/omp-side-session#readme",
	"bugs": {
		"url": "https://github.com/tn-17/omp-side-session/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tn-17/omp-side-session.git"
	},
	"files": [
		"index.ts",
		"README.md",
		"LICENSE",
		"NOTICE"
	],
	"omp": {
		"extensions": [
			"./index.ts"
		]
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"check": "bun run lint && bun run typecheck && bun run test",
		"lint": "biome check .",
		"test": "bun test ./test.ts",
		"typecheck": "tsc -p tsconfig.json"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.3",
		"@types/bun": "^1.3.14",
		"typescript": "^7.0.2"
	}
}
